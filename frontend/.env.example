# Leave empty for local development so Vite proxies /api to port 8000.
# Set this only when the frontend calls a separately hosted backend directly.
VITE_API_BASE_URL=

# Optional E.164 WhatsApp destinations used by dashboard quick actions.
# Leave empty to open WhatsApp's chat picker with the message prefilled.
VITE_EXEC_WHATSAPP_NUMBER=
VITE_CSM_WHATSAPP_NUMBER=
VITE_CUSTOMER_WHATSAPP_NUMBER=
