# StayLongerAI backend configuration
# Copy this file to backend/.env. Keep every real credential out of Git.

# Frontend URL placed in WhatsApp reward links.
# For the recommended one-tunnel demo, replace this with the HTTPS URL from
# `ngrok http 8443` so the same public origin serves the UI and /webhook.
DASHBOARD_BASE_URL=http://localhost:8443
REWARD_LINK_TTL_HOURS=24
# Optional comma-separated browser origins for direct (non-proxied) API use.
CORS_ORIGINS=
# Optional absolute path to Chrome/Chromium for server-side PDF report export.
# Leave blank to auto-detect Chrome, Chromium, or Edge on the host.
REPORT_CHROME_BIN=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated allowlist for the initial authenticated media-download host.
TWILIO_MEDIA_HOSTS=api.twilio.com

# Keep false for an uncomplicated local Sandbox demo. Enable in production
# only after confirming Twilio signs the exact public webhook URL your backend
# validates, including any ngrok/reverse-proxy origin.
TWILIO_VALIDATE_SIGNATURE=false
# Exact public callback (for example https://example.ngrok-free.app/webhook)
# required when validation is enabled behind a rewriting proxy.
TWILIO_WEBHOOK_URL=

# Vonage Messages API Sandbox (optional Twilio alternative)
# Inbound URL: https://your-ngrok-domain/webhook/vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WHATSAPP_FROM=14157386102
VONAGE_MESSAGES_URL=https://messages-sandbox.nexmo.com/v1/messages
VONAGE_MEDIA_HOSTS=api.nexmo.com,api-us.nexmo.com,api-eu.nexmo.com,api-ap.nexmo.com

# ---------------------------------------------------------------------------
# WhatsApp Business Service Provider (BSP). The spec's "Communication" layer.
# Choose one: sleekflow | wati | meta
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=sleekflow
# Optional shared secret expected in the X-Webhook-Secret header for Wati/SleekFlow.
WHATSAPP_WEBHOOK_SECRET=
# Localized interactive template name (pre-approved in your BSP) + language code.
WHATSAPP_TEMPLATE_NAME=value_vault_rescue
WHATSAPP_TEMPLATE_LANGUAGE=en
# Default feature name interpolated into the rescue message + reverse onboarding.
VALUE_VAULT_FEATURE=Inventory Tracker

# --- SleekFlow (https://sleekflow.io) ---
SLEEKFLOW_API_URL=https://api.sleekflow.io/v1/messages/send
SLEEKFLOW_API_KEY=
SLEEKFLOW_MEDIA_HOSTS=sleekflow.io
# Or use a token instead of an API key:
# SLEEKFLOW_TOKEN=

# --- Wati (https://wati.io) ---
# Account-specific endpoint id from your Wati dashboard (e.g. "12345678").
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_MEDIA_HOSTS=wati.io

# --- Meta WhatsApp Cloud API (fallback / direct) ---
# main.py reads these names first and falls back to the legacy short names
# (WHATSAPP_TOKEN / PHONE_NUMBER_ID / VERIFY_TOKEN) for compatibility.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
# App secret signs inbound webhook payloads (X-Hub-Signature-256).
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Reverse Onboarding (Vision LLM). Claude 3.5 Sonnet runs first; Gemini is the
# fallback; EasyOCR is the final safety net when no LLM key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
EASYOCR_GPU=false
EASYOCR_DOWNLOAD_ENABLED=true
EASYOCR_MIN_CONFIDENCE=0.15

# Rewards are simulated unless SOLANA_LIVE_MODE is explicitly true AND every
# required value below is valid. Never paste private keys into source files.
SOLANA_LIVE_MODE=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY_HEX=
USDC_MINT=
PAYMENT_RECIPIENT_WALLET=
X402_PAYMENT_URL=
# User-facing reward value in Malaysian ringgit (UI and WhatsApp copy).
REWARD_DISPLAY_AMOUNT_RM=50
# On-chain USDC amount used only when SOLANA_LIVE_MODE=true.
REWARD_USDC_AMOUNT=50

# ---- Value Vault outbound WhatsApp rescue ----
# When the Uplift Engine classifies an imported customer as "Persuadable", the
# backend automatically sends a WhatsApp message with a 1-tap claim link.
# The CSV/JSON import must include a phone column (phone / whatsapp / mobile /
# phone_number / contact) for a customer to be messaged.
AUTO_SEND_VALUE_VAULT_ON_IMPORT=true
# Reward = MRR * VALUE_VAULT_REWARD_PCT%, clamped to MIN..MAX (Malaysian ringgit).
VALUE_VAULT_REWARD_PCT=10
VALUE_VAULT_REWARD_MIN_RM=10
VALUE_VAULT_REWARD_MAX_RM=150
# Partner voucher brand used in the WhatsApp copy.
VALUE_VAULT_PARTNER=GrabFood
